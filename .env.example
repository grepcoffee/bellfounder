# Copy to .env and adjust. All variables have sane defaults in
# docker-compose.yml, so an empty .env (or none at all) also works for a
# quick local test.

# Where Ollama lives. The default (http://ollama:11434) points at the
# "ollama" service docker-compose.yml runs alongside bellfounder - nothing
# else to install, docker compose up brings up both and pulls the model.
#
# If you'd rather use an Ollama that's already running elsewhere (e.g. a
# foundry-stack box), point this at it instead - e.g.
# http://host.docker.internal:11434 for one running natively on this same
# host (see PLAN.md section 3 for the OLLAMA_HOST=0.0.0.0 systemd override
# that makes that reachable from a container) - and remove/ignore the
# ollama/ollama-pull services in docker-compose.yml.
OLLAMA_URL=http://ollama:11434

# Model to call for /api/ask and /api/roast. qwen2.5:7b is the default and
# is already pulled if foundry-stack's Ollama is used.
BF_MODEL=qwen2.5:7b

# Seconds between automatic roasts during an active session.
BF_ROAST_INTERVAL_S=120

# SQ7 console IP for the read-only MIDI-over-TCP link (Phase 3). Leave
# empty to disable - the app works fine without it.
SQ_HOST=

# Incoming webhook URL for posting the end-of-service summary to Slack
# (Phase 4). Leave empty to disable.
SLACK_WEBHOOK_URL=
